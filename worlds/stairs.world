<?xml version="1.0" ?>
<!-- 台阶 + 斜坡场景：测试爬台阶、上下坡稳定性 -->
<sdf version="1.5">
    <world name="stairs">
        <physics type="ode">
            <type>world</type>
            <max_step_size>0.001</max_step_size>
            <real_time_update_rate>1000</real_time_update_rate>
            <iters>500</iters>
        </physics>

        <include><uri>model://sun</uri></include>
        <include><uri>model://ground_plane</uri></include>

        <!-- ======== 上坡（10 度） ======== -->
        <model name="ramp_up">
            <static>true</static>
            <!-- pose: x y z roll pitch yaw  (pitch 负值 = 向上翘) -->
            <pose>2.5 0.0 0.15 0 -0.1745 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>2.0 1.5 0.05</size></box></geometry>
                    <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
                </collision>
                <visual name="visual">
                    <geometry><box><size>2.0 1.5 0.05</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
                        <name>Gazebo/Brown</name></script></material>
                </visual>
            </link>
        </model>

        <!-- ======== 平台 ======== -->
        <model name="platform_top">
            <static>true</static>
            <pose>4.0 0.0 0.325 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.0 1.5 0.05</size></box></geometry>
                    <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.0 1.5 0.05</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
                        <name>Gazebo/Brown</name></script></material>
                </visual>
            </link>
        </model>

        <!-- ======== 下坡 ======== -->
        <model name="ramp_down">
            <static>true</static>
            <pose>5.5 0.0 0.15 0 0.1745 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>2.0 1.5 0.05</size></box></geometry>
                    <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
                </collision>
                <visual name="visual">
                    <geometry><box><size>2.0 1.5 0.05</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
                        <name>Gazebo/Brown</name></script></material>
                </visual>
            </link>
        </model>

        <!-- ======== 独立台阶（3 级，每级 8cm） ======== -->
        <model name="step_1">
            <static>true</static>
            <pose>8.5 0.0 0.04 0 0 0</pose>
            <link name="link">
                <collision name="collision"><geometry><box><size>0.4 1.2 0.08</size></box></geometry>
                    <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
                </collision>
                <visual name="visual"><geometry><box><size>0.4 1.2 0.08</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
                        <name>Gazebo/DarkGrey</name></script></material></visual>
            </link>
        </model>

        <model name="step_2">
            <static>true</static>
            <pose>8.9 0.0 0.12 0 0 0</pose>
            <link name="link">
                <collision name="collision"><geometry><box><size>0.4 1.2 0.16</size></box></geometry>
                    <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
                </collision>
                <visual name="visual"><geometry><box><size>0.4 1.2 0.16</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
                        <name>Gazebo/DarkGrey</name></script></material></visual>
            </link>
        </model>

        <model name="step_3">
            <static>true</static>
            <pose>9.3 0.0 0.2 0 0 0</pose>
            <link name="link">
                <collision name="collision"><geometry><box><size>0.4 1.2 0.24</size></box></geometry>
                    <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
                </collision>
                <visual name="visual"><geometry><box><size>0.4 1.2 0.24</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
                        <name>Gazebo/DarkGrey</name></script></material></visual>
            </link>
        </model>

    </world>
</sdf>
