# ==============================================================================
#  .gitignore —— 哪些文件不进版本库
#
#  原则：只提交「到哪台机器都一样」的文件。
#        凡是「每台机器不同」或「自动生成」的，一律排除。
# ==============================================================================

# ---------- 每台机器不同的路径配置 ----------
# simenv.conf       → 提交（全空模板，所有机器共用）
# simenv.conf.local → 不提交（make_portable.sh 生成的本机实测值，含用户名和绝对路径）
simenv.conf.local

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- 打包产物（会越滚越大，不入库）----------
*.tar
*.tar.gz
*.tgz
dist/

# ---------- 仿真日志 / 运行输出 ----------
*.log
sim/
log/

# ---------- 临时 / 备份 ----------
*.bak
*.bak-*
*.orig
*.rej
*~
*.swp
.~*

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.code-workspace

# ---------- 系统垃圾 ----------
.DS_Store
Thumbs.db
